[hidden] { display: none !important; }
/* Vivid red controls */
:root{--burgundy:#650000;--burgundy-hi:#ff1717}
.hangup,.danger{background:linear-gradient(135deg,#ff1717 0%,#650000 100%);color:#fff;border:0;outline:0;box-shadow:0 8px 22px rgba(150,0,0,.38)}
.disp.dnc{background:linear-gradient(135deg,#ff1717 0%,#650000 100%);color:#fff;border:0;outline:0}
.alert{background:linear-gradient(135deg,#d60000 0%,#650000 100%);color:#fff;border:0;outline:0;box-shadow:0 8px 22px rgba(150,0,0,.38)}
.hangup:disabled,.danger:disabled{opacity:1!important;filter:none!important;background:linear-gradient(135deg,#ff1717 0%,#650000 100%)!important;color:#fff!important;border:0!important;outline:0!important;box-shadow:none!important;cursor:not-allowed}


/* Travel Empire saturated disposition gradients */
.disposition-rail{
  grid-template-columns:repeat(8,minmax(110px,1fr));
  gap:11px;
}

.disp{
  min-height:52px;
  border:0!important;
  outline:0!important;
  color:#fff!important;
  font-weight:900;
  letter-spacing:.015em;
  text-shadow:0 2px 3px rgba(0,0,0,.75);
  box-shadow:
    0 9px 20px rgba(0,0,0,.48),
    inset 0 1px 0 rgba(255,255,255,.16);
  transition:transform .16s ease,box-shadow .16s ease,filter .16s ease;
}

.disp.not-interested{
  background:linear-gradient(135deg,#526071 0%,#111722 100%)!important;
}

.disp.dnc{
  background:linear-gradient(135deg,#ff1717 0%,#650000 100%)!important;
}

.disp.callback{
  background:linear-gradient(135deg,#ffb000 0%,#743b00 100%)!important;
}

.disp.no-answer{
  background:linear-gradient(135deg,#168ce0 0%,#06345d 100%)!important;
}

.disp.email{
  background:linear-gradient(135deg,#00b8d4 0%,#03475f 100%)!important;
}

.disp.voicemail{
  background:linear-gradient(135deg,#6445ff 0%,#281369 100%)!important;
}

.disp.language{
  background:linear-gradient(135deg,#d52cff 0%,#521069 100%)!important;
}

.disp.success{
  background:linear-gradient(135deg,#18ce72 0%,#05572d 100%)!important;
}

.disp:hover{
  transform:translateY(-3px);
  filter:saturate(1.18) brightness(1.08);
  box-shadow:
    0 14px 28px rgba(0,0,0,.62),
    inset 0 1px 0 rgba(255,255,255,.22);
}

.disp:active{
  transform:translateY(1px);
  box-shadow:0 5px 12px rgba(0,0,0,.5);
}

.disp:focus-visible{
  box-shadow:
    0 12px 25px rgba(0,0,0,.58),
    0 0 0 2px #fff;
}

@media(max-width:1200px){
  .disposition-rail{
    grid-template-columns:repeat(4,minmax(120px,1fr));
  }
}
/* End disposition gradients */


/* Brushed nickel 3D dispositions */
.disp{
  --metal-light:#f7f8fa;
  --metal-dark:#555c66;
  --accent:#526071;
  --accent-dark:#111722;
  --edge:#252b34;

  position:relative;
  min-height:54px;
  border:2px solid transparent!important;
  border-radius:11px;
  outline:0!important;
  color:#fff!important;
  font-weight:950;
  letter-spacing:.02em;
  text-shadow:0 2px 3px rgba(0,0,0,.9);

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.55) 0%,
      rgba(255,255,255,.12) 20%,
      rgba(0,0,0,.08) 48%,
      rgba(0,0,0,.48) 100%
    ) padding-box,
    repeating-linear-gradient(
      90deg,
      rgba(255,255,255,.07) 0 1px,
      rgba(0,0,0,.06) 1px 3px
    ) padding-box,
    linear-gradient(
      135deg,
      var(--accent) 0%,
      var(--accent-dark) 100%
    ) padding-box,
    linear-gradient(
      135deg,
      #fafafa 0%,
      #707782 18%,
      #e7e9ec 38%,
      #686f79 58%,
      #f4f5f6 78%,
      #525862 100%
    ) border-box!important;

  box-shadow:
    0 5px 0 var(--edge),
    0 13px 22px rgba(0,0,0,.65),
    inset 0 2px 1px rgba(255,255,255,.58),
    inset 0 -8px 12px rgba(0,0,0,.35);

  transform:perspective(400px) rotateX(3deg);
  transition:transform .16s ease,box-shadow .16s ease,filter .16s ease;
}

.disp.not-interested{
  --accent:#53616f;
  --accent-dark:#111722;
  --edge:#252b32;
}

.disp.dnc{
  --accent:#ff1717;
  --accent-dark:#650000;
  --edge:#420000;
}

.disp.callback{
  --accent:#ffb000;
  --accent-dark:#713700;
  --edge:#472400;
}

.disp.no-answer{
  --accent:#168ce0;
  --accent-dark:#06345d;
  --edge:#03233f;
}

.disp.email{
  --accent:#00bad8;
  --accent-dark:#03475f;
  --edge:#022f3f;
}

.disp.voicemail{
  --accent:#6445ff;
  --accent-dark:#281369;
  --edge:#190c44;
}

.disp.language{
  --accent:#d52cff;
  --accent-dark:#521069;
  --edge:#340941;
}

.disp.success{
  --accent:#18ce72;
  --accent-dark:#05572d;
  --edge:#03391d;
}

.disp:hover{
  transform:perspective(400px) rotateX(0deg) translateY(-4px);
  filter:saturate(1.2) brightness(1.1);
  box-shadow:
    0 7px 0 var(--edge),
    0 18px 30px rgba(0,0,0,.72),
    inset 0 2px 1px rgba(255,255,255,.7),
    inset 0 -8px 12px rgba(0,0,0,.3);
}

.disp:active{
  transform:translateY(4px);
  box-shadow:
    0 1px 0 var(--edge),
    0 5px 10px rgba(0,0,0,.6),
    inset 0 3px 8px rgba(0,0,0,.45);
}
