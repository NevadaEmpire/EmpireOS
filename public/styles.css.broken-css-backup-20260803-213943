/* Dial mode selector */
.dial-mode-panel {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
  padding: 12px;
  border: 1px solid rgba(120,143,181,.24);
  border-radius: 16px;
  background: #050b16;
}

.dial-mode-title strong {
  display: block;
  color: #fff;
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.dial-mode-title span {
  display: block;
  margin-top: 3px;
  color: rgba(186,198,219,.72);
  font-size: 12px;
}

.dial-mode-buttons {
  display: grid;
  grid-template-columns: repeat(3, minmax(82px, 1fr));
  gap: 8px;
}

.dial-mode-button {
  border: 1px solid rgba(120,143,181,.28);
  border-radius: 12px;
  padding: 9px 10px;
  background: rgba(255,255,255,.035);
  color: rgba(230,237,248,.85);
  font-weight: 800;
  letter-spacing: .04em;
  cursor: pointer;
}

.dial-mode-button.active {
  border-color: rgba(216,174,91,.75);
  background: linear-gradient(180deg, rgba(216,174,91,.28), rgba(216,174,91,.08));
  color: #fff;
}

.last-call-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(216,174,91,.34);
  border-radius: 12px;
  padding: 9px 11px;
  color: #fff;
  background: rgba(216,174,91,.08);
  font-weight: 800;
  white-space: nowrap;
}

.last-call-toggle input {
  transform: scale(1.15);
}

@media (max-width: 860px) {
  .dial-mode-panel {
    grid-template-columns: 1fr;
